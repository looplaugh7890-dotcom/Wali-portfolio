# MongoDB Atlas
# Create a free cluster at https://www.mongodb.com/cloud/atlas, then paste the
# connection string here (include your database user's password, and a
# database name at the end of the path, e.g. .../waliaslam?retryWrites=true).
MONGODB_URI=mongodb://hasnain9729198_db_user:OuhmRJSzxw5nrzzC@ac-0kxxkax-shard-00-00.uggbe9w.mongodb.net:27017,ac-0kxxkax-shard-00-01.uggbe9w.mongodb.net:27017,ac-0kxxkax-shard-00-02.uggbe9w.mongodb.net:27017/scioderm?ssl=true&replicaSet=atlas-ko4tpv-shard-0&authSource=admin&appName=

# Session/auth
# Any long random string. Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Used ONLY by the seed script (npm run seed) to create your first admin
# login. After seeding, these are not read again — change your password
# from inside /admin if you ever need to.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-before-seeding

# Public site URL (used for metadata, sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — only needed if you wire up real image uploads later.
# Until these are set, the admin panel accepts image URLs directly
# (e.g. paste a link from Cloudinary's dashboard uploader, imgur, etc.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
